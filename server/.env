# ─────────────────────────────────────────────────────────────────
# Nexora Studio — Server Environment Variables
# Fill ALL values before running npm run dev
# ─────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/nexora-studio

# JWT — use a long random string (min 32 chars)
JWT_SECRET=replace_with_a_very_long_random_secret_string

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary — get from cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — get from razorpay.com dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email — Gmail App Password
# Go to Google Account → Security → 2-Step Verification → App Passwords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# Admin seed — used by npm run seed to create first admin
# CHANGE THESE before running seed
ADMIN_EMAIL=admin@nexorastudio.com
ADMIN_PASSWORD=NexoraAdmin@2024!
